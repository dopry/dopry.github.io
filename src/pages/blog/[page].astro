---
import type { GetStaticPaths, Page } from "astro";
import { getCollection } from "astro:content";
import PostTeasers from "../../components/PostTeasers.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { BlogPost } from "../../types/blog";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPosts = (
    await getCollection("blog", ({ data }) => !data.draft)
  ).sort(
    (a, b) =>
      new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
  );

  const pageSize = 10;
  return paginate(allPosts, { pageSize });
};

interface Props {
  page: Page<BlogPost>;
}

const { page }: Props = Astro.props;

const newerHref =
  page.currentPage === 2
    ? "/blog/1"
    : page.currentPage > 2
      ? `/blog/${page.currentPage - 1}`
      : undefined;

const olderHref =
  page.currentPage < page.lastPage
    ? `/blog/${page.currentPage + 1}`
    : undefined;
---

<BaseLayout>
  <h1>Blog</h1>

  <div class="pagination flex justify-between items-center">
    <div class="w-third">{newerHref && <a href={newerHref}>Newer</a>}</div>
    <div class="w-third tc">Page {page.currentPage} of {page.lastPage}</div>
    <div class="w-third tr">{olderHref && <a href={olderHref}>Older</a>}</div>
  </div>
  <div class="pv2">
    <PostTeasers posts={page.data} />
  </div>
  <div class="pagination flex justify-between items-center">
    <div class="w-third">{newerHref && <a href={newerHref}>Newer</a>}</div>
    <div class="w-third tc">Page {page.currentPage} of {page.lastPage}</div>
    <div class="w-third tr">{olderHref && <a href={olderHref}>Older</a>}</div>
  </div>
</BaseLayout>
