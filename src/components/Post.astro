---
import type { BlogPost } from "../types/blog";
import { render } from "astro:content";
import { formatDate } from "../util/formatDate.js";
import Tags from "./Tags.astro";
import BlogImage from "./BlogImage.astro";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props as Props;
const { Content } = await render(post);
---

<div class="post cf mb4">
  <h1 class="post-title ba pa2">{post.data.title}</h1>
  <div class="post-date">{formatDate(post.data.pubDate)}</div>
  <Tags tags={post.data.tags} />
  {
    post.data.images?.map((image) => (
      <BlogImage image={image} class="fr ml3 mb1 mw5" width={200} />
    ))
  }

  <Content />
</div>
