---
interface Props {
  tagCounts: Array<[string, number]>;
}

const { tagCounts } = Astro.props as Props;

const counts = tagCounts.map(([, count]) => count);
const min = counts.length ? Math.min(...counts) : 0;
const max = counts.length ? Math.max(...counts) : 0;
const range = Math.max(max - min, 1);

const fontSize = (count: number) => {
  const t = (count - min) / range; // 0..1
  const size = 0.85 + t * 0.75; // rem scaling between 0.85rem and 1.6rem
  return `${size.toFixed(2)}rem`;
};
---

{
  tagCounts.length === 0 ? (
    <p>No tags found.</p>
  ) : (
    <div class="tag-cloud flex flex-wrap items-center">
      {tagCounts.map(([tag, count]) => (
        <a
          href={`/tags/${tag}/1`}
          class="link dim mr3 mb3"
          style={{ fontSize: fontSize(count) }}
          aria-label={`${tag} (${count})`}
        >
          {tag}
        </a>
      ))}
    </div>
  )
}
