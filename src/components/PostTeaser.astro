---
import { marked } from "marked";
import type { BlogPost } from "../types/blog";
import { formatDate } from "../util/formatDate.js";
import Tags from "./Tags.astro";
import BlogImage from "./BlogImage.astro";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props as Props;
const renderedDescription = post.data.description
  ? marked(post.data.description)
  : null;
---

<div class="teaser cf">
  <h2 class="post-title ba pa2">
    <a href={`/blog/${post.slug}`}>
      {post.data.title}
    </a>
  </h2>
  <div class="post-date mb3">{formatDate(post.data.pubDate)}</div>
  <Tags tags={post.data.tags} />

  {renderedDescription && <div class="teaser" set:html={renderedDescription} />}

  <div class="cf"></div>
  {
    post.data.images.map((image) => (
      <BlogImage image={image} class="fl ma2" width={150} />
    ))
  }
</div>
