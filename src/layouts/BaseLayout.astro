---
import "../styles/globals.css";

interface Props {
  title?: string;
}

const { title = "Darrel O'Pry" } = Astro.props;
const currentPath = Astro.url.pathname;
const isHome = currentPath === "/";
const pageTitle = isHome
  ? `${title} · living one bug at a time...`
  : `${title} · Darrel O'Pry`;

const navLinks = [
  { href: "/", label: "Home", match: (path: string) => path === "/" },
  {
    href: "/blog/1",
    label: "Blog",
    match: (path: string) => path.startsWith("/blog/"),
  },
  {
    href: "/tags",
    label: "Tags",
    match: (path: string) => path.startsWith("/tags"),
  },
  {
    href: "/about-me",
    label: "About Me",
    match: (path: string) => path.startsWith("/about-me"),
  },
];
---

<!doctype html>
<html lang="en-us">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-5M4MCX2");
    </script>
    <!-- End Google Tag Manager -->

    <meta charset="utf-8" />
    <meta http-equiv="content-type" content="text/html; charset=utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1"
    />

    <title>{pageTitle}</title>

    <!-- CSS -->
    <link rel="stylesheet" href="/css/tachyons.css" />
    <link rel="stylesheet" href="/css/syntax.css" />

    <!-- Icons -->
    <link
      rel="apple-touch-icon-precomposed"
      sizes="144x144"
      href="/apple-touch-icon-144-precomposed.png"
    />
    <link rel="shortcut icon" href="/favicon.ico" />

    <!-- RSS -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="RSS"
      href="/atom.xml"
    />
  </head>

  <body class="w100 ph4 pv3">
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-5M4MCX2"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >

    <header class="mw8">
      <a href="/" title="Home" class="mr2">
        <h3 class="b" style="color: #0f0;">
          Darrel O'Pry --<small class="now">living one bug at a time...</small>
        </h3>
      </a>
    </header>
    <nav class="mw8 ba pa2">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class={`nowrap mr3 ${link.match(currentPath) ? "current" : ""}`.trim()}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="mw8 mt2">
      <slot />
    </div>

    <footer class="mw8 mt4 pa2 ba mb2">
      &copy; {new Date().getFullYear()} Darrel O'Pry. All rights reserved.
    </footer>
  </body>
</html>

<style is:global>
  @import url("/css/syntax.css");
</style>
