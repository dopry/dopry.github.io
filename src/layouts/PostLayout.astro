---
import Post from "../components/Post.astro";
import type { BlogPost } from "../types/blog";
import BaseLayout from "./BaseLayout.astro";

interface Neighbor {
  slug: string;
  title: string;
}

interface Props {
  post: BlogPost;
  prev?: Neighbor | null;
  next?: Neighbor | null;
}

const { post, prev, next } = Astro.props;
---

<BaseLayout title={post.data.title}>
  <div class="post-pagination flex">
    <div class="w-50">
      {prev && <a href={`/blog/${prev.slug}`}>← Newer: {prev.title}</a>}
    </div>
    <div class="w-50 tr">
      {next && <a href={`/blog/${next.slug}`}>Older: {next.title} →</a>}
    </div>
  </div>
  <Post post={post} />
  <div class="post-pagination flex">
    <div class="w-50">
      {prev && <a href={`/blog/${prev.slug}`}>← Newer: {prev.title}</a>}
    </div>
    <div class="w-50 tr">
      {next && <a href={`/blog/${next.slug}`}>Older: {next.title} →</a>}
    </div>
  </div>
</BaseLayout>
